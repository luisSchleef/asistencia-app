# Plantilla de variables del stack Docker (.env está en .gitignore).
# Opción rápida: ./setup.sh  (copia este archivo a .env y genera JWT_SECRET solo)
# Opción manual:
#   cp .env.example .env
# Sin .env el compose igual arranca con valores por defecto (solo demo local).

POSTGRES_USER=asistencias
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=asistencias
# Secreto para firmar los JWT. Generar uno nuevo, ej: openssl rand -hex 32
# setup.sh lo genera automáticamente si dejas el valor placeholder.
JWT_SECRET=cambiar-por-un-secreto-largo
